/* ============================================================
   PDFU — Main Stylesheet
   Primary:   #E74856
   Hover:     #CF404C
   Pressed:   #B83540
   Sidebar:   #2B2D31
   Sidebar HL:#E74856
   BG:        #F5F5F7
   Surface:   #FFFFFF
   Text:      #1A1A2E
   Muted:     #6B7280
   Border:    #E0E0E0
   ============================================================ */

/* ── Global ── */
QMainWindow, QWidget {
    background-color: #F5F5F7;
    color: #1A1A2E;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

/* ── Sidebar ── */
#sidebar {
    background-color: #2B2D31;
    border-right: none;
}

/* ── Nav buttons (sidebar) ── */
#navButton {
    background-color: transparent;
    color: #B0B8C1;
    border: none;
    border-radius: 0px;
    text-align: left;
    padding: 0px 0px 0px 8px;
    font-size: 13px;
    font-weight: 500;
    min-height: 48px;
}

#navButton:hover {
    background-color: rgba(255, 255, 255, 0.07);
    color: #FFFFFF;
}

#navButton[active="true"] {
    background-color: rgba(231, 72, 86, 0.20);
    color: #FFFFFF;
    border-left: 3px solid #E74856;
}

#toggleButton {
    background-color: transparent;
    color: #B0B8C1;
    border: none;
    border-radius: 0px;
    text-align: left;
    padding: 0px 0px 0px 8px;
    font-size: 13px;
    min-height: 48px;
}

#toggleButton:hover {
    background-color: rgba(255, 255, 255, 0.07);
    color: #FFFFFF;
}

#versionLabel {
    color: #4A4D52;
    font-size: 11px;
    padding: 8px;
}

/* ── Content area ── */
#contentArea {
    background-color: #F5F5F7;
}

/* ── Top bar ── */
#topBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
}

#topBarTitle {
    color: #1A1A2E;
    font-size: 15px;
    font-weight: 600;
}

#topBarBrand {
    color: #E74856;
    font-size: 15px;
    font-weight: 700;
}

/* ── Pages ── */
#pageContainer {
    background-color: #F5F5F7;
}

/* ── Cards / panels ── */
#card {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 10px;
}

/* ── Page title ── */
#pageTitle {
    color: #1A1A2E;
    font-size: 22px;
    font-weight: 700;
}

#pageSubtitle {
    color: #6B7280;
    font-size: 13px;
}

/* ── FilePicker widget ── */
#filePickerLabel {
    color: #4B5563;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

#filePickerInput {
    background-color: #F9FAFB;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    padding: 6px 10px;
    color: #1A1A2E;
    font-size: 13px;
    selection-background-color: #E74856;
}

#filePickerInput:focus {
    border: 1px solid #E74856;
    background-color: #FFFFFF;
}

#filePickerButton {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    color: #4B5563;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    min-width: 80px;
}

#filePickerButton:hover {
    background-color: #F3F4F6;
    border-color: #D1D5DB;
    color: #1A1A2E;
}

#filePickerButton:pressed {
    background-color: #E5E7EB;
}

/* ── Primary action button ── */
#primaryButton {
    background-color: #E74856;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    padding: 10px 28px;
    min-height: 42px;
}

#primaryButton:hover {
    background-color: #CF404C;
}

#primaryButton:pressed {
    background-color: #B83540;
}

#primaryButton:disabled {
    background-color: #D1D5DB;
    color: #9CA3AF;
}

/* ── Progress bar ── */
QProgressBar {
    background-color: #E5E7EB;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #E74856;
    border-radius: 4px;
}

#progressLabel {
    color: #6B7280;
    font-size: 12px;
}

/* ── Slider (compress quality) ── */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background-color: #E5E7EB;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #E74856;
    border: none;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin: -5px 0;
}

QSlider::sub-page:horizontal {
    background-color: #E74856;
    border-radius: 3px;
}

/* ── Thumbnail list (rotate page) ── */
#thumbnailList {
    background-color: #F9FAFB;
    border: 1px solid #E0E0E0;
    border-radius: 8px;
    padding: 8px;
}

#thumbnailList::item {
    border: 2px solid transparent;
    border-radius: 6px;
    padding: 4px;
    margin: 4px;
}

#thumbnailList::item:selected {
    background-color: rgba(231, 72, 86, 0.10);
    border: 2px solid #E74856;
}

#thumbnailList::item:hover {
    background-color: rgba(231, 72, 86, 0.05);
}

/* ── Message boxes ── */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QPushButton {
    background-color: #E74856;
    border: none;
    border-radius: 6px;
    color: #FFFFFF;
    font-weight: 600;
    padding: 6px 20px;
    min-width: 80px;
}

QMessageBox QPushButton:hover {
    background-color: #CF404C;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #D1D5DB;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #9CA3AF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background: #D1D5DB;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #9CA3AF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Rotate page action buttons ── */
#rotateActionButton {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    color: #4B5563;
    font-size: 12px;
    font-weight: 500;
    padding: 5px 10px;
}

#rotateActionButton:hover {
    background-color: #F3F4F6;
    border-color: #E74856;
    color: #E74856;
}

#rotateActionButton:disabled {
    color: #D1D5DB;
    border-color: #E5E7EB;
}

/* ── Separator ── */
#separator {
    background-color: #E0E0E0;
    max-height: 1px;
}
